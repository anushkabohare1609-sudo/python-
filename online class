sender = input("enter sender name: ")
receiver = input("enter receiver name: ")
parcel_type = input("enter parcel type: ")
location = input("enter delivery location: ")

print("\n========== courier receipt ==========")
print("sender name       :", sender)
print("receiver name     :", receiver)
print("parcel type       :", parcel_type)
print("delivery location :", location)
