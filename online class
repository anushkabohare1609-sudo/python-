tracking_code = input("\nenter tracking code: ")

letters = 0
digits = 0

for ch in tracking_code:
    if ch.isalpha():
        letters += 1
    elif ch.isdigit():
        digits += 1

print("\n========== tracking analysis ==========")
print("number of letters :", letters)
print("number of digits  :", digits)
print("=======================================")
