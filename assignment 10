
import matplotlib.pyplot as plt

# Data
x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 25, 30]

# 1. Line Plot
plt.plot(x, y)
plt.title("Line Plot")
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.show()

# 2. Scatter Plot
plt.scatter(x, y)
plt.title("Scatter Plot")
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.show()

# 3. Box Plot
data = [10, 20, 30, 40, 50, 60, 70]
plt.boxplot(data)
plt.title("Box Plot")
plt.show()

# 4. Bar Chart
names = ["A", "B", "C", "D"]
marks = [80, 70, 90, 60]

plt.bar(names, marks)
plt.title("Bar Chart")
plt.xlabel("Students")
plt.ylabel("Marks")
plt.show()

# 5. Pie Chart
subjects = ["Python", "Java", "C++", "DBMS"]
values = [30, 25, 20, 25]

plt.pie(values, labels=subjects, autopct="%1.1f%%")
plt.title("Pie Chart")
plt.show()



